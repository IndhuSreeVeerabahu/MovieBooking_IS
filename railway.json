{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "java -Xmx512m -Xms256m -XX:+UseG1GC -XX:+UseStringDeduplication -jar target/MovieTicketBooking-0.0.1-SNAPSHOT.jar --spring.profiles.active=prod --server.port=$PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}